generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  COURIER
  ADMIN
}

enum VehicleType {
  BICYCLE
  MOTORBIKE
  VAN
  TRUCK
}

enum ServiceType {
  STANDARD
  EXPRESS
}

enum ShipmentStatus {
  CREATED
  PICKUP_SCHEDULED
  COURIER_ASSIGNED
  PICKED_UP
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY_ATTEMPT
  RETURN_TO_SENDER
  RETURNED
  CANCELLED
}

enum TransferStatus {
  DISPATCHED
  ARRIVED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EarningStatus {
  PENDING
  PAID
}

enum NotificationType {
  SHIPMENT_UPDATE
  ASSIGNMENT
  PAYMENT
  SYSTEM
}

model User {
  id             String  @id @default(cuid())
  name           String
  email          String  @unique
  passwordHash   String?
  googleId       String? @unique
  phone          String?
  role           Role    @default(CUSTOMER)
  isActive       Boolean @default(true)
  organizationId String?

  organization   Organization?   @relation(fields: [organizationId], references: [id])
  courierProfile CourierProfile?
  addresses      Address[]

  shipmentsAsCustomer Shipment[]              @relation("CustomerShipments")
  shipmentsAsCourier  Shipment[]              @relation("CourierShipments")
  statusChangesActed  ShipmentStatusHistory[]
  payments            Payment[]
  courierEarnings     CourierEarning[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([organizationId])
}

model Organization {
  id   String @id @default(cuid())
  name String @unique

  members   User[]
  shipments Shipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CourierProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  vehicleType     VehicleType
  licenseNumber   String
  zoneId          String?
  isAvailable     Boolean     @default(true)
  rating          Decimal     @default(5.0) @db.Decimal(3, 2)
  totalDeliveries Int         @default(0)

  user User  @relation(fields: [userId], references: [id])
  zone Zone? @relation(fields: [zoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([isAvailable])
}

model Zone {
  id     String  @id @default(cuid())
  name   String  @unique
  city   String
  region String?

  hubs                      Hub[]
  couriers                  CourierProfile[]
  addresses                 Address[]
  pricingRulesAsOrigin      PricingRule[]    @relation("OriginZone")
  pricingRulesAsDestination PricingRule[]    @relation("DestinationZone")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Hub {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  address  String
  zoneId   String
  capacity Int     @default(1000)
  isActive Boolean @default(true)

  zone Zone @relation(fields: [zoneId], references: [id])

  originShipments      Shipment[]    @relation("OriginHub")
  destinationShipments Shipment[]    @relation("DestinationHub")
  currentShipments     Shipment[]    @relation("CurrentHub")
  transfersDispatched  HubTransfer[] @relation("TransferFromHub")
  transfersReceived    HubTransfer[] @relation("TransferToHub")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([zoneId])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String?
  addressLine  String
  city         String
  zoneId       String?
  lat          Float?
  lng          Float?
  contactName  String
  contactPhone String

  user User  @relation(fields: [userId], references: [id])
  zone Zone? @relation(fields: [zoneId], references: [id])

  pickupShipments   Shipment[] @relation("PickupAddress")
  deliveryShipments Shipment[] @relation("DeliveryAddress")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([zoneId])
}

model PricingRule {
  id                String      @id @default(cuid())
  originZoneId      String
  destinationZoneId String
  serviceType       ServiceType
  minWeightKg       Decimal     @db.Decimal(6, 2)
  maxWeightKg       Decimal     @db.Decimal(6, 2)
  basePrice         Decimal     @db.Decimal(10, 2)
  perKgRate         Decimal     @db.Decimal(10, 2)
  isActive          Boolean     @default(true)
  effectiveFrom     DateTime    @default(now())

  originZone      Zone @relation("OriginZone", fields: [originZoneId], references: [id])
  destinationZone Zone @relation("DestinationZone", fields: [destinationZoneId], references: [id])

  createdAt DateTime @default(now())

  @@unique([originZoneId, destinationZoneId, serviceType, minWeightKg])
  @@index([originZoneId, destinationZoneId, serviceType, isActive])
}

model Shipment {
  id                 String         @id @default(cuid())
  trackingNumber     String         @unique
  customerId         String
  organizationId     String?
  assignedCourierId  String?
  pickupAddressId    String
  deliveryAddressId  String
  originHubId        String?
  destinationHubId   String?
  currentHubId       String?
  serviceType        ServiceType    @default(STANDARD)
  status             ShipmentStatus @default(CREATED)
  parcelWeightKg     Decimal        @db.Decimal(6, 2)
  parcelDescription  String?
  parcelValue        Decimal?       @db.Decimal(10, 2)
  priceAmount        Decimal        @db.Decimal(10, 2)
  currency           String         @default("USD")
  failedAttemptCount Int            @default(0)
  returnReason       String?

  customer        User          @relation("CustomerShipments", fields: [customerId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  assignedCourier User?         @relation("CourierShipments", fields: [assignedCourierId], references: [id])
  pickupAddress   Address       @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddress Address       @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  originHub       Hub?          @relation("OriginHub", fields: [originHubId], references: [id])
  destinationHub  Hub?          @relation("DestinationHub", fields: [destinationHubId], references: [id])
  currentHub      Hub?          @relation("CurrentHub", fields: [currentHubId], references: [id])

  statusHistory  ShipmentStatusHistory[]
  hubTransfers   HubTransfer[]
  payments       Payment[]
  courierEarning CourierEarning?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([assignedCourierId])
  @@index([status])
  @@index([organizationId])
}

model ShipmentStatusHistory {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  note        String?
  location    String?
  actorUserId String?

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  actor    User?    @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([actorUserId])
}

model HubTransfer {
  id           String         @id @default(cuid())
  shipmentId   String
  fromHubId    String
  toHubId      String
  status       TransferStatus @default(DISPATCHED)
  dispatchedAt DateTime       @default(now())
  arrivedAt    DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  fromHub  Hub      @relation("TransferFromHub", fields: [fromHubId], references: [id])
  toHub    Hub      @relation("TransferToHub", fields: [toHubId], references: [id])

  @@index([shipmentId])
}

model Payment {
  id                    String          @id @default(cuid())
  shipmentId            String
  customerId            String
  provider              PaymentProvider @default(STRIPE)
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @default("USD")
  status                PaymentStatus   @default(PENDING)
  stripeSessionId       String?         @unique
  stripePaymentIntentId String?         @unique
  paidAt                DateTime?

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  customer User     @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([customerId])
  @@index([status])
}

model CourierEarning {
  id         String        @id @default(cuid())
  courierId  String
  shipmentId String        @unique
  amount     Decimal       @db.Decimal(10, 2)
  status     EarningStatus @default(PENDING)
  paidAt     DateTime?

  courier  User     @relation(fields: [courierId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([courierId])
  @@index([status])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id          String  @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  changes     Json?
  ipAddress   String?

  actor User? @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
}
