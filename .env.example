# Server
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database (Neon Postgres, or any Postgres instance)
# DATABASE_URL: pooled connection - used by the app at runtime.
# DIRECT_URL: direct/non-pooled connection - required by Prisma Migrate/db pull.
# On Neon, DIRECT_URL is the same host as DATABASE_URL minus "-pooler". For a plain
# (non-pooled) Postgres instance, both can point to the same URL.
DATABASE_URL=postgresql://user:password@localhost:5432/courier_logistics
DIRECT_URL=postgresql://user:password@localhost:5432/courier_logistics

# Auth (configured in Day 2)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
GOOGLE_CLIENT_ID=

# Redis (rate limiting + admin dashboard-stats caching). Optional - the app fails
# open safely without it: rate limiting is skipped and stats are computed fresh
# on every request instead of served from cache. Use a real instance (e.g. Upstash
# for serverless deployments) in production for both features to actually work.
REDIS_URL=redis://localhost:6379

# Stripe (test-mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=http://localhost:3000

# Cloudinary (configured if file uploads are added)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
